server {
    listen 80;
    listen [::]:80;

    server_name chunjae-it-edu.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl ipv6only=on;
    server_name         chunjae-it-edu.com;

    # Let’s Encrypt 인증서
    ssl_certificate     /etc/letsencrypt/live/chunjae-it-edu.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chunjae-it-edu.com/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        root   /usr/share/nginx/html;
        index  index.html;
        try_files $uri $uri/ /index.html;
    }

    # /api/* → backend 컨테이너
    location ^~ /api/ {
        proxy_pass         http://genieq-backend:8080;
        proxy_set_header   Host            $host;
        proxy_set_header   X-Real-IP       $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # /fastapi/* → api 컨테이너 (포트 8501)
    location ^~ /fastapi/ {
        rewrite ^/fastapi/(.*)$ /$1 break;
        proxy_pass         http://genieq-api:8501;
        proxy_set_header   Host            $host;
        proxy_set_header   X-Real-IP       $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 300s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
    }

    error_page 502 503 504 /50x.html;
    location = /50x.html {
        internal;
    }
}
